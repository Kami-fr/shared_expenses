# Python
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Home Assistant dev instance
config/

# Frontend
#
# The Vite project lives in frontend/, outside the integration: only its output
# ships. custom_components/shared_expenses/ then holds nothing but what runs.
node_modules/
frontend/dist/

# The built panel is committed on purpose: HACS ships the repository as is and
# never runs a build, so custom_components/shared_expenses/www/index.js must be
# versioned.

# Local tooling
#
# The one workstation's own settings, holding the commands it was told to allow
# with its absolute paths in them. A .claude/settings.json meant for everybody
# would still be versioned.
.claude/settings.local.json

# What one session leaves the next: where the work stands, what is left, and the
# quirks of this machine. Written to be thrown away once its contents have
# landed somewhere permanent — a roadmap, a commit message, an ADR — so it is
# never committed, and ignored rather than merely untracked so that it stops
# showing up as something forgotten.
HANDOFF.md
